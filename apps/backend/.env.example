NODE_ENV=development
PORT=4000

FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001,http://192.168.1.8:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arkan_crm?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

JWT_ACCESS_SECRET=dev_access_secret_change_later_please_make_it_long
JWT_ISSUER=arkan-crm
JWT_AUDIENCE=arkan-crm-users

# legacy (default) keeps Bearer/sessionStorage behavior. dual/cookie are
# prepared for the staged migration; production requires COOKIE_SECURE=true.
AUTH_COOKIE_MODE=legacy
COOKIE_SECURE=false

# Rate limiting (all windows default to 60s where applicable).
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_GLOBAL_PER_MIN=600
# RATE_LIMIT_LOGIN_PER_MIN=10
# RATE_LIMIT_REFRESH_PER_MIN=30
# RATE_LIMIT_CSRF_PER_MIN=60
# RATE_LIMIT_EXPENSIVE_READ_PER_MIN=120
# RATE_LIMIT_UPLOAD_PER_MIN=20
# RATE_LIMIT_PUSH_REGISTER_PER_MIN=20
# RATE_LIMIT_PUSH_TEST_PER_MIN=5
# RATE_LIMIT_STORAGE=memory   # memory | redis
# RATE_LIMIT_KEY_PREFIX=arkan:rate-limit:

# Disabled by default. Only explicit proxy IPs/CIDRs, never true/*.
# TRUST_PROXY=127.0.0.1/32,::1/128
