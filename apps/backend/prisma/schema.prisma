generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MANAGER
  EMPLOYEE
}

enum PropertyStatus {
  PENDING
  AVAILABLE
  REJECTED
  SOLD
  RENTED
  ARCHIVED
}

enum DealType {
  SALE
  RENT
  EXCHANGE
}

enum ContactType {
  OWNER
  BROKER
}

enum FloorType {
  GROUND
  FIRST
  SECOND
  THIRD
  FOURTH
  FIFTH
  SIXTH
  SEVENTH
  ROOF
  MEZZANINE
  BASEMENT
  HALF
  QUARTER
  CUSTOM
}

enum AssignmentPurpose {
  MARKETING
  OWNER_FOLLOWUP
  VIEWINGS
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum CommissionRole {
  PROPERTY_EMPLOYEE
  CLIENT_EMPLOYEE
  MANUAL
}

enum FinanceDirection {
  INCOME
  EXPENSE
}

enum FinanceSourceType {
  DEAL
  COMMISSION
  PAYROLL
  MANUAL_EXPENSE
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
}

// In-app notification events. One value per business event so a notification can
// never be mistaken for another; `SYSTEM` is the reserved default for legacy or
// generic rows that predate the event catalogue.
enum NotificationType {
  PROPERTY_SUBMITTED
  PROPERTY_CHANGES_REQUESTED
  PROPERTY_REJECTED
  PROPERTY_RESUBMITTED
  PROPERTY_APPROVED
  PROPERTY_AVAILABLE
  SYSTEM
  // Employee record-activity events. Enum values are APPENDED after `SYSTEM` on
  // purpose: PostgreSQL `ALTER TYPE ... ADD VALUE` always appends, so the
  // database keeps the exact order declared here and no future diff drifts.
  CLIENT_CREATED
  CLIENT_UPDATED
  CLIENT_INTEREST_UPDATED
  FOLLOWUP_CREATED
  CONTACT_CREATED
  CONTACT_UPDATED
  // Client review workflow events (client review requests). APPENDED after the
  // record events, same appends-only convention (PostgreSQL `ALTER TYPE ... ADD VALUE`).
  CLIENT_REVIEW_SUBMITTED
  CLIENT_REVIEW_RESUBMITTED
  CLIENT_REVIEW_APPROVED
  CLIENT_REVIEW_REJECTED
  CLIENT_REVIEW_CHANGES_REQUESTED
  // Employee follow-ups late-escalation events. APPENDED after the review
  // events, same appends-only convention (PostgreSQL `ALTER TYPE ... ADD VALUE`).
  FOLLOWUP_EMPLOYEE_LATE
  FOLLOWUP_MANAGER_ESCALATION
  // Manual manager reminder of ONE overdue employee follow-up. APPENDED after
  // the escalation events, same appends-only convention (PostgreSQL
  // `ALTER TYPE ... ADD VALUE`). The recipient is by construction the subject's
  // responsible employee, so the row is never masked.
  FOLLOWUP_EMPLOYEE_REMINDER
  PROPERTY_PRIORITY_EXPIRED
}

model User {
  id                      String                    @id @default(uuid()) @db.Uuid
  email                   String                    @unique
  passwordHash            String
  name                    String
  role                    Role                      @default(EMPLOYEE)
  isActive                Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  employee                EmployeeProfile?
  refreshTokens           RefreshToken[]
  pushSubscriptions       PushSubscription[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  recordedDeals           Deal[]
  requestedApprovals      PropertyApprovalRequest[] @relation("ApprovalRequester")
  reviewedApprovals       PropertyApprovalRequest[] @relation("ApprovalReviewer")
  uploadedFiles           FileAsset[]
  createdCommissions      Commission[]
  createdPayrollEntries   PayrollEntry[]
  createdFinanceMovements FinanceMovement[]
  createdManualExpenses   ManualExpense[]
  responsibleContacts     Contact[]                 @relation("ContactResponsible")
  createdProperties       Property[]                @relation("PropertyCreatedByUser")
  registeredProperties   PropertyRegistrant[]      @relation("PropertyRegistrantEmployee")
  approvedRegistrations  PropertyRegistrant[]      @relation("PropertyRegistrantApprover")
  priorityHeldProperties Property[]                @relation("PropertyPriorityHolder")
  deletedProperties      Property[]                @relation("PropertyDeletedBy")
  propertyTombstones     PropertyTombstone[]       @relation("PropertyTombstoneDeletedBy")
  requestedRevisions      PropertyRevision[]        @relation("RevisionRequester")
  reviewedRevisions       PropertyRevision[]        @relation("RevisionReviewer")
  requestedClientReviews  ClientReviewRequest[]     @relation("ClientReviewRequester")
  reviewedClientReviews   ClientReviewRequest[]     @relation("ClientReviewReviewer")
  /// Manager-registered clients with NO responsible employee (the manager is
  /// the follow-up's responsible user himself, see FollowUpSubject).
  clientsCreatedByUser    Client[]                  @relation("ClientCreatedByUser")
  /// Manager-owned follow-up subjects (responsible user = this manager).
  responsibleFollowUpSubjects  FollowUpSubject[]    @relation("FollowUpSubjectResponsibleUser")
  /// Manager-authored follow-up history entries (the manager saved the note).
  authoredFollowUpEntries FollowUpEntry[]           @relation("FollowUpEntryAuthor")
  /// Manual reminders this manager sent.
  followUpRemindersSent   FollowUpReminder[]        @relation("FollowUpReminderSender")
  /// Manual reminders this user received (always the responsible employee).
  followUpRemindersReceived FollowUpReminder[]      @relation("FollowUpReminderRecipient")
  /// Receive notifications when employees save new follow-ups (default off).
  notifyEmployeeFollowUps Boolean                   @default(false)
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  // Stable "login family" id. A refresh ROTATES the token row, so the row id
  // alone cannot identify a device; this lineage survives every rotation and
  // is revoked as a whole on logout. NULL for sessions created before the
  // column existed: they keep working normally but can never receive Web Push.
  lineageId String?   @db.Uuid

  @@index([userId, expiresAt])
  @@index([lineageId])
}

/**
 * One browser's Web Push subscription, bound to the authenticated manager AND
 * to the verified session lineage it was created from. The `endpoint` is unique
 * per browser, so a shared browser can never carry a subscription of another
 * account: subscribing replaces the endpoint's owner with the current session.
 */
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The session lineage that owns this subscription. A push is only delivered
  // while this lineage still has a live session (see `PushService`).
  lineageId String   @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, lineageId])
}

model EmployeeProfile {
  id                 String               @id @default(uuid()) @db.Uuid
  userId             String               @unique @db.Uuid
  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  phone              String?
  hiredAt            DateTime?
  baseSalary         Decimal?             @db.Decimal(14, 2)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  createdClients     Client[]             @relation("ClientCreator")
  responsibleClients Client[]             @relation("ClientResponsible")
  createdOwners      Owner[]              @relation("OwnerCreator")
  responsibleOwners  Owner[]              @relation("OwnerResponsible")
  createdProperties  Property[]
  assignments        PropertyAssignment[]
  followups          FollowUp[]
  propertyDeals      Deal[]               @relation("PropertyEmployee")
  clientDeals        Deal[]               @relation("ClientEmployee")
  commissions        Commission[]
  payroll            PayrollEntry[]
  attendance         AttendanceRecord[]
  followUpSubjects   FollowUpSubject[]
  followUpEntries    FollowUpEntry[]
}

model Client {
  id                    String           @id @default(uuid()) @db.Uuid
  name                  String
  phone                 String
  notes                 String?
  source                String?
  status                String?
  /**
   * Structured wizard request state for THIS client (a JSON document packed
   * and unpacked ONLY by the clients service, like the FollowUp notes
   * contract). Nullable: every legacy row kept as-is and degrades to "no
   * structured request recorded yet" — never a rewrite of human notes.
   */
  requestData           String?
  createdById           String?          @db.Uuid
  createdBy             EmployeeProfile? @relation("ClientCreator", fields: [createdById], references: [id], onDelete: Restrict)
  responsibleEmployeeId String?          @db.Uuid
  responsibleEmployee   EmployeeProfile? @relation("ClientResponsible", fields: [responsibleEmployeeId], references: [id], onDelete: Restrict)
  /// The MANAGER who registered this client when NO employee is responsible —
  /// the stable `User.id` relationship that makes the client's follow-up
  /// MANAGER-owned (same dual-link precedent as `Property.createdByUserId`).
  /// Null for every existing row: only manager saves without an assigned
  /// employee ever write it, so nothing old changes meaning.
  createdByUserId       String?          @db.Uuid
  createdByUser         User?            @relation("ClientCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deals                 Deal[]
  followups             FollowUp[]
  notifications         Notification[]
  propertyInterests     ClientPropertyInterest[]
  reviewRequests        ClientReviewRequest[]
  followUpSubjects      FollowUpSubject[]

  @@index([responsibleEmployeeId])
  @@index([phone])
  @@index([createdByUserId])
}

model Owner {
  id                    String           @id @default(uuid()) @db.Uuid
  name                  String
  phone                 String
  notes                 String?
  source                String?
  status                String?
  createdById           String?          @db.Uuid
  createdBy             EmployeeProfile? @relation("OwnerCreator", fields: [createdById], references: [id], onDelete: Restrict)
  responsibleEmployeeId String?          @db.Uuid
  responsibleEmployee   EmployeeProfile? @relation("OwnerResponsible", fields: [responsibleEmployeeId], references: [id], onDelete: Restrict)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  properties            Property[]
  followups             FollowUp[]
  notifications         Notification[]

  @@index([responsibleEmployeeId])
  @@index([phone])
}

model Property {
  id                String                    @id @default(uuid()) @db.Uuid
  reference         String                    @unique
  /// Official A-code assigned ONLY at approval (null while pending/rejected).
  approvedReference String?                   @unique
  title             String
  area              String
  address           String?
  governorate       String?
  district          String?
  plotNumber        String?
  sizeSqm           Decimal?                  @db.Decimal(14, 2)
  bedrooms          Int?
  bathrooms         Int?
  floorCount        Int?
  block             String?
  street            String?
  description       String?
  askingPrice       Decimal?                  @db.Decimal(14, 2)
  negotiable        Boolean?
  currency          String                    @db.Char(3)
  status            PropertyStatus            @default(PENDING)
  listingType       DealType
  version           Int                       @default(1)
  ownerId           String?                   @db.Uuid
  owner             Owner?                    @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdById       String?                   @db.Uuid
  createdBy         EmployeeProfile?          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdByUserId   String?                   @db.Uuid
  createdByUser     User?                     @relation("PropertyCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  contactId         String?                   @db.Uuid
  contact           Contact?                  @relation(fields: [contactId], references: [id], onDelete: Restrict)
  primaryImageId    String?                   @unique @db.Uuid
  primaryImage      FileAsset?                @relation("PropertyPrimaryImage", fields: [primaryImageId], references: [id], onDelete: Restrict)
  /// Soft-delete (Trash) markers. NULL = active. Restore is Manager-only.
  deletedAt         DateTime?
  deletedByUserId   String?                   @db.Uuid
  deletedBy         User?                     @relation("PropertyDeletedBy", fields: [deletedByUserId], references: [id], onDelete: Restrict)
  deletionReason    String?
  /// Provisional owner typed by an EMPLOYEE on a pending submission.
  /// Promoted into an official Contact only when a Manager approves.
  proposedOwner     Json?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  assignments       PropertyAssignment[]
  approvals         PropertyApprovalRequest[]
  deals             Deal[]
  followups         FollowUp[]
  notifications     Notification[]
  files             FileAsset[]               @relation("PropertyFiles")
  manualExpenses    ManualExpense[]
  floors            PropertyFloor[]
  requestedProperty RequestedProperty?
  revisions         PropertyRevision[]
  propertyInterests ClientPropertyInterest[]
  followUpSubjects  FollowUpSubject[]
  registrants       PropertyRegistrant[]
  priorityHolderUserId String?                   @db.Uuid
  priorityHolder    User?                      @relation("PropertyPriorityHolder", fields: [priorityHolderUserId], references: [id], onDelete: Restrict)
  priorityDeadline  DateTime?
  priorityExpiredNotifiedAt DateTime?
  priorityLocked    Boolean                    @default(false)

  @@index([area, status])
  @@index([ownerId])
  @@index([contactId])
  @@index([createdByUserId])
  @@index([deletedAt])
  @@index([governorate, district])
  // Indexed prefix lookup for the property code (`A-000123`): the pattern
  // operator lets a `LIKE 'A-0001%'` search use the index instead of a scan.
  @@index([reference(ops: raw("text_pattern_ops"))], type: BTree)
}

/**
 * The atomic counter behind the property codes.
 *
 * A single row is incremented with `UPDATE ... RETURNING`, so concurrent
 * employees can never receive the same code and a code is never reused. The
 * value only grows: a failed creation leaves a gap, never a reused number.
 */
model PropertyCodeSequence {
  id    Int    @id
  value BigInt @default(0)
}

model Contact {
  id                String      @id @default(uuid()) @db.Uuid
  type              ContactType
  name              String
  phone             String
  notes             String?
  responsibleUserId String?     @db.Uuid
  responsibleUser   User?       @relation("ContactResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  properties        Property[]
  notifications     Notification[]

  @@index([type, responsibleUserId])
  @@index([phone])
}

/// Minimal, non-sensitive tombstone kept after a permanent deep delete. It
/// reserves the original property code forever (unique reference) and records
/// who deleted the property and when, without retaining house/owner details.
model PropertyTombstone {
  id              String   @id @default(uuid()) @db.Uuid
  reference       String   @unique
  deletedByUserId String?  @db.Uuid
  deletedBy       User?    @relation("PropertyTombstoneDeletedBy", fields: [deletedByUserId], references: [id], onDelete: Restrict)
  deletedAt       DateTime @default(now())
  summary         Json?

  @@index([deletedAt])
}

model PropertyFloor {
  id          String    @id @default(uuid()) @db.Uuid
  propertyId  String    @db.Uuid
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type        FloorType
  customLabel String?
  details     String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([propertyId, sortOrder])
}

model RequestedProperty {
  id                String   @id @default(uuid()) @db.Uuid
  propertyId        String   @unique @db.Uuid
  property          Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  governorate       String?
  district          String?
  block             String?
  plotNumber        String?
  sizeSqm           Decimal? @db.Decimal(14, 2)
  floorRequirements String?
  notes             String?
  budgetMin         Decimal? @db.Decimal(14, 2)
  budgetMax         Decimal? @db.Decimal(14, 2)

  @@index([governorate, district])
}

/**
 * Interest of an EXISTING program property from one client (a recorded inquiry
 * — "هذا العميل يسأل عن هذا العقار"), NOT a generic property-request table:
 * rows can only attach to real `Property.id` values validated at write time.
 *
 * Referential actions:
 * - `clientId` Cascade — an interest belongs to its client's lifecycle.
 * - `propertyId` Restrict — deleting a property must never silently destroy
 *   the interest history; any removal path must face the count first.
 * The (client, property) pair is unique, so a repeated submission can never
 * create a duplicate link.
 */
model ClientPropertyInterest {
  id         String   @id @default(uuid()) @db.Uuid
  clientId   String   @db.Uuid
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  reason     String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([clientId, propertyId])
  @@index([propertyId])
}

model PropertyRevision {
  id            String         @id @default(uuid()) @db.Uuid
  propertyId    String         @db.Uuid
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  status        ApprovalStatus @default(PENDING)
  payload       Json
  baseVersion   Int
  requestedById String         @db.Uuid
  requestedBy   User           @relation("RevisionRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedById  String?        @db.Uuid
  reviewedBy    User?          @relation("RevisionReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewNotes   String?
  createdAt     DateTime       @default(now())
  reviewedAt    DateTime?

  @@index([propertyId, status])
  @@index([status, createdAt])
  @@index([requestedById])
}

/**
 * A staged client change that an EMPLOYEE submits for manager approval.
 *
 * NOTHING here is an approved `Client` row until a manager approves, so a
 * pending creation can never appear in any client list/search/statistic, and a
 * pending edit never touches the approved client data.
 *
 * Constraints live in SQL (like `PropertyRevision_one_pending_per_property`):
 * - `client_review_active_edit_per_client`: at most ONE ACTIVE review per
 *   client (`kind='EDIT'` with status PENDING or CHANGES_REQUESTED) —
 *   resubmission continues the SAME row.
 * - `client_review_idempotency_per_requester`: a repeated accidental
 *   submission with the same request-scoped key returns the same review
 *   instead of a duplicate. It is scoped to the requester on purpose: two
 *   employees may legitimately use equal keys (two wizard sessions) without
 *   ever seeing one another.
 * - Deliberately NO uniqueness on `requestedById` alone: an employee may have
 *   several creation reviews in flight at once.
 */
model ClientReviewRequest {
  id             String         @id @default(uuid()) @db.Uuid
  /// `CREATION` = a proposed NEW client (no `clientId`); `EDIT` = a proposed
  /// change to an existing approved client (always with a `clientId`).
  kind           ClientReviewKind
  clientId       String?        @db.Uuid
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  status         ApprovalStatus @default(PENDING)
  /**
   * The proposed data, stored opaquely and decoded ONLY by the client review
   * service (same convention as `Client.requestData`). For `EDIT` it holds the
   * full proposed state; for `CREATION` it holds the whole proposed client.
   */
  payload        Json
  /**
   * `EDIT` only: a snapshot of the approved client (identity fields, the
   * stored request document and the current linked interests) taken at
   * submission time. Approval re-reads the client inside the SAME transaction
   * and compares it: a mismatch means the row moved during review → safe 409,
   * never a silent rebase of someone else's real change.
   */
  base           Json?
  /**
   * Requester-scoped idempotency key generated by the wizard session. A
   * repeated accidental POST (double click, network retry) resolves to the
   * SAME review row instead of creating a second one.
   */
  idempotencyKey String?        @db.Uuid
  requestedById  String         @db.Uuid
  requestedBy    User           @relation("ClientReviewRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedById   String?        @db.Uuid
  reviewedBy     User?          @relation("ClientReviewReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewNotes    String?
  createdAt      DateTime       @default(now())
  reviewedAt     DateTime?

  notifications  Notification[]

  @@index([status, createdAt])
  @@index([requestedById])
  @@index([clientId])
}

/// The two review kinds: a proposed new client, or a proposed edit.
enum ClientReviewKind {
  CREATION
  EDIT
}

model PropertyAssignment {
  id         String            @id @default(uuid()) @db.Uuid
  propertyId String            @db.Uuid
  property   Property          @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  employeeId String            @db.Uuid
  employee   EmployeeProfile   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  purpose    AssignmentPurpose
  createdAt  DateTime          @default(now())

  @@unique([propertyId, employeeId, purpose])
  @@index([employeeId])
}

model PropertyApprovalRequest {
  id            String         @id @default(uuid()) @db.Uuid
  propertyId    String         @db.Uuid
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  requestedById String         @db.Uuid
  requestedBy   User           @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedById  String?        @db.Uuid
  reviewedBy    User?          @relation("ApprovalReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  status        ApprovalStatus @default(PENDING)
  notes         String?
  createdAt     DateTime       @default(now())
  reviewedAt    DateTime?
  duplicateCandidateIds Json?

  @@index([status, createdAt])
}

model PropertyRegistrant {
  id               String          @id @default(uuid()) @db.Uuid
  propertyId       String          @db.Uuid
  property         Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  employeeUserId   String          @db.Uuid
  employee         User            @relation("PropertyRegistrantEmployee", fields: [employeeUserId], references: [id], onDelete: Restrict)
  registrationOrder Int
  status           ApprovalStatus  @default(PENDING)
  approvedById     String?         @db.Uuid
  approvedBy       User?           @relation("PropertyRegistrantApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt       DateTime?
  createdAt        DateTime        @default(now())

  @@unique([propertyId, employeeUserId])
  @@index([employeeUserId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model FollowUp {
  id            String          @id @default(uuid()) @db.Uuid
  employeeId    String          @db.Uuid
  employee      EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  clientId      String?         @db.Uuid
  client        Client?         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  ownerId       String?         @db.Uuid
  owner         Owner?          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  propertyId    String?         @db.Uuid
  property      Property?       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  dueAt         DateTime
  completedAt   DateTime?
  status        FollowUpStatus  @default(PENDING)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  notifications Notification[]

  @@index([employeeId, status, dueAt])
}

/**
 * The kinds of follow-up SUBJECTS the employee follow-ups feature schedules.
 *
 * A subject is the durable scheduling unit behind ONE actual property, ONE
 * approved client request, ONE property interest or ONE legacy client —
 * never a whole person and never a pile of free-text notes.
 */
enum FollowUpSubjectKind {
  /// The owner of ONE approved property (per property, not per person).
  PROPERTY_OWNER
  /// ONE approved structured request of a client (`BUYER`/`RENTER`/`EXCHANGER`
  /// from the stored `Client.requestData` document — never inferred from notes).
  CLIENT_REQUEST
  /// ONE recorded `ClientPropertyInterest` (an inquiry about a real property).
  INQUIRY
  /// A legacy client with NO structured request document: ONE client-level
  /// subject so old rows keep working WITHOUT fabricating request structure.
  CLIENT
}

/**
 * ONE durable follow-up subject per actual property/request — the scheduling
 * unit of the employee follow-ups feature.
 *
 * Durability & de-duplication: `targetKey` is a database `@unique`, so
 * repeated approvals, page reloads, retries and concurrent sync jobs always
 * converge on the SAME row — a second subject for the same target is
 * physically impossible.
 *
 * Schedule: every timestamp is stored in UTC and evaluated SERVER-side only.
 * `cycle` starts at 1 and increments with every saved note; the escalation
 * columns remember the last cycle each threshold fired in, so each threshold
 * notifies at most once per cycle (the `Notification.eventKey` carries the
 * cycle too, making retries no-ops at the database level).
 *
 * Grouping of subjects into people is a FRONTEND concern only: rows here stay
 * strictly per-target, each with its own due date, history and responsibility.
 */
model FollowUpSubject {
  id            String              @id @default(uuid()) @db.Uuid
  /// Canonical target identity (`@@unique` = one subject per real target):
  ///   PROPERTY_OWNER:<propertyId>
  ///   CLIENT_REQUEST:<clientId>:<BUYER|RENTER|EXCHANGER>
  ///   INQUIRY:<interestId>
  ///   CLIENT:<clientId>
  targetKey     String              @unique
  kind          FollowUpSubjectKind
  /// The employee responsible for this follow-up (the property's OWNER_FOLLOWUP
  /// assignment or enterer, or the client's responsible employee) — the ONLY
  /// scope employee list/history/save paths are ever filtered by. Null exactly
  /// when a MANAGER is the responsible user instead (see `responsibleUserId`);
  /// the two columns are mutually exclusive (exactly one is set — CHECK
  /// constraint in the migration).
  responsibleId String?             @db.Uuid
  responsible   EmployeeProfile?    @relation(fields: [responsibleId], references: [id], onDelete: Restrict)
  /// The responsible USER when the follow-up belongs to a MANAGER personally
  /// (his own properties / registered clients with no assigned employee).
  /// Null exactly when `responsibleId` is set; never both, never neither.
  /// Employees' rows keep it null, so the employee `responsible.userId` scope
  /// can never match a manager-owned row — and vice versa.
  responsibleUserId String?         @db.Uuid
  responsibleUser User?             @relation("FollowUpSubjectResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: Restrict)

  propertyId    String?             @db.Uuid
  property      Property?           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  clientId      String?             @db.Uuid
  client        Client?             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  /// Deliberately a plain id WITHOUT a foreign key: interest rows are
  /// upserted/removed by every approved client edit, and a permanent
  /// conversation history must never be deleted with them. The sync
  /// deactivates the subject when the interest disappears.
  interestId    String?             @db.Uuid

  /// First activation (approval/first safe sync) — UTC.
  activatedAt   DateTime
  /// Set with the first saved note; null until then («لم تتم متابعتها»).
  lastSavedAt   DateTime?
  /// Next contact due = server save/activation timestamp + interval (UTC).
  nextDueAt     DateTime
  /// Follow-up cycle counter (starts at 1; +1 per saved note).
  cycle             Int             @default(1)
  /// The last cycle in which each escalation threshold fired (0 = never).
  employeeWarnedCycle Int            @default(0)
  managerEscalatedCycle Int          @default(0)

  /// Inactive = terminal/no longer owed (property SOLD/RENTED/ARCHIVED,
  /// interest gone, responsibility gone). History is always kept.
  active        Boolean             @default(true)
  deactivatedAt DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  entries       FollowUpEntry[]
  notifications Notification[]
  reminders     FollowUpReminder[]

  @@index([responsibleId, active, nextDueAt])
  @@index([responsibleUserId, active, nextDueAt])
  @@index([active, kind])
}

/**
 * A permanent, append-only follow-up history entry: notes are never edited,
 * replaced or deleted through the API — corrections are NEW entries.
 *
 * One panel submit (ONE phone conversation covering several subjects) writes
 * one entry PER SAVED SUBJECT, sharing `batchId` so they can be correlated
 * WITHOUT ever merging the subjects' independent histories. The
 * `(authorId, batchId, subjectId)` unique also makes a double-submitted batch
 * resolve to the already-committed rows instead of duplicating them
 * (PostgreSQL treats NULL `batchId`s as distinct, so single-note legacy
 * writes stay unaffected).
 */
model FollowUpEntry {
  id        String          @id @default(uuid()) @db.Uuid
  subjectId String          @db.Uuid
  subject   FollowUpSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  note      String
  /// The EMPLOYEE author — null exactly when a MANAGER saved this note
  /// (see `authorUserId`; the two are mutually exclusive, exactly one set).
  authorId  String?         @db.Uuid
  author    EmployeeProfile? @relation(fields: [authorId], references: [id], onDelete: Restrict)
  /// The MANAGER author (his own follow-ups): the actual, verified session
  /// user of every manager-saved note — never a client claim.
  authorUserId String?      @db.Uuid
  authorUser User?           @relation("FollowUpEntryAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  batchId   String?         @db.Uuid
  /// The subject's due date BEFORE this note reset it (null on first save).
  prevDueAt DateTime?
  /// The due date this note produced (server timestamp + interval).
  nextDueAt DateTime?
  createdAt DateTime        @default(now())

  @@unique([authorId, batchId, subjectId])
  @@unique([authorUserId, batchId, subjectId])
  @@index([subjectId, createdAt])
}

/**
 * ONE manual manager reminder of ONE overdue employee follow-up subject.
 *
 * A reminder is deliberately NOT a follow-up entry: it never touches the
 * subject's due date, cycle or history — it only records (and notifies through
 * the EXISTING notification pipeline) that the manager told the responsible
 * employee to catch up. The `eventKey` is time-windowed cooldown key
 * (`FOLLOWUP_EMPLOYEE_REMINDER:<subjectId>:<window>`), unique at the database
 * level, so two concurrent clicks, retries or double taps can physically
 * never send two reminders for the same subject inside one cooldown window.
 */
model FollowUpReminder {
  id              String          @id @default(uuid()) @db.Uuid
  subjectId       String          @db.Uuid
  subject         FollowUpSubject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  /// The MANAGER who sent the reminder — verified session user only.
  senderUserId    String          @db.Uuid
  senderUser      User            @relation("FollowUpReminderSender", fields: [senderUserId], references: [id], onDelete: Restrict)
  /// The responsible EMPLOYEE who received it (snapshot of the recipient).
  recipientUserId String          @db.Uuid
  recipientUser   User            @relation("FollowUpReminderRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  /// The cooldown-window deduplication key, unique in the database.
  eventKey        String          @unique
  sentAt          DateTime        @default(now())

  @@index([subjectId, sentAt])
}

model Deal {
  id                 String            @id @default(uuid()) @db.Uuid
  reference          String            @unique
  type               DealType
  propertyId         String            @db.Uuid
  property           Property          @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  clientId           String            @db.Uuid
  client             Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  recordedById       String            @db.Uuid
  recordedBy         User              @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  propertyEmployeeId String?           @db.Uuid
  propertyEmployee   EmployeeProfile?  @relation("PropertyEmployee", fields: [propertyEmployeeId], references: [id], onDelete: Restrict)
  clientEmployeeId   String?           @db.Uuid
  clientEmployee     EmployeeProfile?  @relation("ClientEmployee", fields: [clientEmployeeId], references: [id], onDelete: Restrict)
  price              Decimal           @db.Decimal(14, 2)
  companyCommission  Decimal           @db.Decimal(14, 2)
  currency           String            @db.Char(3)
  closedAt           DateTime
  createdAt          DateTime          @default(now())
  commissions        Commission[]
  financeMovements   FinanceMovement[]
  notifications      Notification[]

  @@index([propertyId])
  @@index([clientId])
}

model Commission {
  id               String            @id @default(uuid()) @db.Uuid
  dealId           String            @db.Uuid
  deal             Deal              @relation(fields: [dealId], references: [id], onDelete: Restrict)
  employeeId       String            @db.Uuid
  employee         EmployeeProfile   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  commissionRole   CommissionRole
  createdById      String            @db.Uuid
  createdBy        User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  notes            String?
  amount           Decimal           @db.Decimal(14, 2)
  currency         String            @db.Char(3)
  calculationNotes String?
  status           PaymentStatus     @default(PENDING)
  paidAt           DateTime?
  createdAt        DateTime          @default(now())
  financeMovements FinanceMovement[]

  @@index([employeeId, status])
  @@index([dealId])
}

model PayrollEntry {
  id               String            @id @default(uuid()) @db.Uuid
  employeeId       String            @db.Uuid
  employee         EmployeeProfile   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdById      String            @db.Uuid
  createdBy        User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  notes            String?
  period           DateTime          @db.Date
  baseSalary       Decimal           @db.Decimal(14, 2)
  deductions       Decimal           @default(0) @db.Decimal(14, 2)
  bonus            Decimal           @default(0) @db.Decimal(14, 2)
  netAmount        Decimal           @db.Decimal(14, 2)
  currency         String            @db.Char(3)
  status           PaymentStatus     @default(PENDING)
  paidAt           DateTime?
  createdAt        DateTime          @default(now())
  financeMovements FinanceMovement[]
  notifications    Notification[]

  @@unique([employeeId, period])
}

model ManualExpense {
  id               String            @id @default(uuid()) @db.Uuid
  reference        String            @unique
  type             String
  amount           Decimal           @db.Decimal(14, 2)
  currency         String            @db.Char(3)
  description      String
  propertyId       String?           @db.Uuid
  property         Property?         @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  createdById      String            @db.Uuid
  createdBy        User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  occurredAt       DateTime
  createdAt        DateTime          @default(now())
  financeMovements FinanceMovement[]

  @@index([propertyId])
  @@index([createdById, occurredAt])
