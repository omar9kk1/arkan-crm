model FinanceMovement {
  id               String            @id @default(uuid()) @db.Uuid
  reference        String            @unique
  direction        FinanceDirection
  sourceType       FinanceSourceType
  sourceId         String            @db.Uuid
  dealId           String?           @db.Uuid
  deal             Deal?             @relation(fields: [dealId], references: [id], onDelete: Restrict)
  commissionId     String?           @db.Uuid
  commission       Commission?       @relation(fields: [commissionId], references: [id], onDelete: Restrict)
  payrollEntryId   String?           @db.Uuid
  payrollEntry     PayrollEntry?     @relation(fields: [payrollEntryId], references: [id], onDelete: Restrict)
  manualExpenseId  String?           @db.Uuid
  manualExpense    ManualExpense?    @relation(fields: [manualExpenseId], references: [id], onDelete: Restrict)
  createdById      String            @db.Uuid
  createdBy        User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  amount           Decimal           @db.Decimal(14, 2)
  currency         String            @db.Char(3)
  counterparty     String
  calculationNotes String?
  notes            String?
  occurredAt       DateTime
  createdAt        DateTime          @default(now())

  @@index([sourceType, sourceId])
  @@index([manualExpenseId])
  @@index([occurredAt, direction])
}

model AttendanceRecord {
  id         String           @id @default(uuid()) @db.Uuid
  employeeId String           @db.Uuid
  employee   EmployeeProfile  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  date       DateTime         @db.Date
  status     AttendanceStatus
  checkIn    DateTime?
  checkOut   DateTime?
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([employeeId, date])
}

model Notification {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // `body` is the short, privacy-safe message shown under `title` in the bell.
  type           NotificationType @default(SYSTEM)
  title          String
  body           String
  // Deduplication key for the originating business event, e.g.
  // `PROPERTY_SUBMITTED:<propertyId>`. Combined with `userId` in a database
  // unique index so a repeated/duplicated/retried event can never create two
  // notifications for the same recipient.
  eventKey       String?
  readAt         DateTime?
  createdAt      DateTime      @default(now())
  propertyId     String?       @db.Uuid
  property       Property?     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  clientId       String?       @db.Uuid
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  ownerId        String?       @db.Uuid
  owner          Owner?        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  // Modern Owner/Broker contact cards (legacy `ownerId` above is retired and
  // never written again — it points at the old `Owner` model, NOT at `Contact`).
  contactId      String?       @db.Uuid
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: Restrict)
  dealId         String?       @db.Uuid
  deal           Deal?         @relation(fields: [dealId], references: [id], onDelete: Restrict)
  followUpId     String?       @db.Uuid
  followUp       FollowUp?     @relation(fields: [followUpId], references: [id], onDelete: Restrict)
  payrollEntryId String?       @db.Uuid
  payrollEntry   PayrollEntry? @relation(fields: [payrollEntryId], references: [id], onDelete: Restrict)
  // Client review workflow deep-link target. The recipient of a review event
  // is by construction ALWAYS authorized to open it (the requester, or a
  // manager for the company-wide feed), so no extra visibility masking.
  clientReviewId String?       @db.Uuid
  clientReview   ClientReviewRequest? @relation(fields: [clientReviewId], references: [id], onDelete: Restrict)
  // Employee follow-up escalation deep link. The EMPLOYEE rows are addressed
  // to the subject's responsible employee by construction (the only person
  // authorized to open the follow-ups page for that subject); the API masks
  // this column for managers, who land on their existing pages instead.
  followUpSubjectId String?    @db.Uuid
  followUpSubject   FollowUpSubject? @relation(fields: [followUpSubjectId], references: [id], onDelete: Restrict)

  // Recipient + read state + chronological listing (the bell's hot path), plus
  // the per-recipient event deduplication guarantee.
  @@unique([userId, eventKey])
  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @db.Uuid
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String
  entityId   String   @db.Uuid
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

model FileAsset {
  id              String    @id @default(uuid()) @db.Uuid
  bucket          String
  key             String    @unique
  mimeType        String
  sizeBytes       BigInt
  uploadedById    String    @db.Uuid
  uploadedBy      User      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  propertyId      String?   @db.Uuid
  property        Property? @relation("PropertyFiles", fields: [propertyId], references: [id], onDelete: Restrict)
  primaryImageFor Property? @relation("PropertyPrimaryImage")
  createdAt       DateTime  @default(now())

  @@index([propertyId])
}
