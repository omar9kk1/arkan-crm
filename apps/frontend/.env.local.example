NEXT_PUBLIC_API_URL=http://localhost:4000
# legacy is the default; dual/cookie require matching backend AUTH_COOKIE_MODE.
NEXT_PUBLIC_AUTH_MODE=legacy
# For other devices on the LAN, copy to .env.local and use the laptop IP:
# NEXT_PUBLIC_API_URL=http://192.168.1.8:4000
# Restart Next.js after changing this value (rebuild for production).
# off | report-only | enforce (enforce requires nonce/dynamic rendering)
CSP_MODE=report-only
