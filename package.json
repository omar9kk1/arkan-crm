{
  "name": "arkan-crm",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev -w @arkan/backend",
    "dev:frontend": "npm run dev -w @arkan/frontend",
    "build": "npm run build -w @arkan/shared && npm run build -w @arkan/backend && npm run build -w @arkan/frontend",
    "typecheck": "npm run build -w @arkan/shared && npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w @arkan/backend",
    "db:generate": "npm run db:generate -w @arkan/backend",
    "db:migrate": "npm run db:migrate -w @arkan/backend",
    "db:deploy": "npm run db:deploy -w @arkan/backend"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
