{
  "name": "arkan-crm",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run backend:start && npm run dev:frontend",
    "dev:backend": "npm run backend:start",
    "dev:frontend": "npm run dev -w @arkan/frontend",
    "backend:start": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/backend-dev.ps1 start",
    "backend:status": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/backend-dev.ps1 status",
    "backend:logs": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/backend-dev.ps1 logs",
    "backend:logs:follow": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/backend-dev.ps1 logs -Follow -Lines 120",
    "backend:stop": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/backend-dev.ps1 stop",
    "backend:restart": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/backend-dev.ps1 restart",
    "build": "npm run build -w @arkan/shared && npm run build -w @arkan/backend && npm run build -w @arkan/frontend",
    "typecheck": "npm run build -w @arkan/shared && npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w @arkan/backend",
    "test:auth": "npm run test -w @arkan/backend -- auth.spec.ts auth-cookie-mode.spec.ts frontend-auth-mode.spec.ts frontend-authorized.spec.ts",
    "test:csp": "npm run test -w @arkan/backend -- csp-policy.spec.ts && npm run csp:test -w @arkan/frontend",
    "check": "npm run typecheck && npm run lint",
    "db:generate": "npm run db:generate -w @arkan/backend",
    "db:migrate": "npm run db:migrate -w @arkan/backend",
    "db:deploy": "npm run db:deploy -w @arkan/backend"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
