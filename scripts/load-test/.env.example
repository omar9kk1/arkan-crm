# Load-test configuration. Copy/export these values in your shell; never commit
# a real .env file. The database name MUST be arkan_crm_load_test.

# Required: disposable PostgreSQL database for load-test data only.
LOAD_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/arkan_crm_load_test?schema=public

# Required: loopback test backend. Port 4001 (the real dev API) is rejected.
LOAD_API_URL=http://127.0.0.1:4101

# Required: password assigned to generated load-test accounts.
LOAD_TEST_PASSWORD=change-me

# Optional paths (defaults live under the OS temp directory).
# LOAD_STATE_FILE=
# LOAD_BACKEND_PID_FILE=

# Optional generator stage (A/B/C) and verify stage.
# LOAD_STAGE=A
